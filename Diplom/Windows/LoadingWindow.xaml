<Window x:Class="Diplom.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Diplom"
        mc:Ignorable="d"
        Title="Загрузка" Height="300" Width="300" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#FF352F2F" AllowsTransparency="True">
    <Grid>
        <Ellipse Name="LoadingCircle" Width="130" Height="130" Stroke="White" StrokeThickness="4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="Rotation" Angle="0" CenterX="30" CenterY="30" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <TextBlock Text="Загрузка..." Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Grid>
</Window>
