<Page x:Class="Diplom.UpdateSoftware"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom"
      mc:Ignorable="d" Width="950"
      Title="DownloadBotPage" Height="632">
    <Page.Resources>

        <DropShadowEffect x:Key="MaterialDesignShadow" 
                          ShadowDepth="2" 
                          Direction="270" 
                          Color="Black" 
                          Opacity="0.3" 
                          BlurRadius="5"/>
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                            From="0" To="1"
                            Duration="0:0:0.5"
                            DecelerationRatio="0.9"/>
        </Storyboard>

    </Page.Resources>

    <Border CornerRadius="15" Margin="10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2D2D2D" Offset="0"/>
                <GradientStop Color="#3C3C3C" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Настройка приложений"
                      Grid.Row="0"
                      FontSize="24"
                      FontWeight="Bold"
                      Foreground="#FFFFFF"
                      Margin="20,20,0,10"
                      HorizontalAlignment="Left"/>
            <Button VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Margin="100,10,10,10"
                    Content="Вернуться назад к приложениям" Grid.Column="1" Click="BackToApps"/>
            <local:BlockWithQuestion HintText="Данное поле отвечает за то, как будет отображаться вызов этого приложения в логах и как бот будет озвучивать что он открывает. Также данное поле проверяется - если такое название есть у ваших приложений, то его нельзя будет добавить"
                                     TitleText="Название приложения"
                                     Question="Visible"
                                     Grid.Row="1"
                                     Grid.ColumnSpan="2"
                                     Height="100"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center"
                                     Width="650">
                <local:BlockWithQuestion.FieldContent>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Width="300" d:Text="Тестовое название программы" Text="{Binding TitleSoftware}"/>
                        <Button Grid.Column="1"
                            Margin="15,10"
                            Content="Проверить название"
                                Click="TestAppTitle_Click"/>
                    </Grid>
                </local:BlockWithQuestion.FieldContent>
            </local:BlockWithQuestion>
            <local:BlockWithQuestion HintText="{Binding HelpTextSoftwareTypes, Mode=TwoWay}"
                                     Question="Visible"
                                     TitleText="Тип приложения"
                                     Grid.Row="2"
                                     Height="100"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center"
                                     Width="250">
                <local:BlockWithQuestion.FieldContent>
                    <Grid>
                        <ComboBox Width="Auto"
                                  ItemsSource="{Binding SoftwareTypes, Mode=TwoWay}"
                                  SelectedItem="{Binding SelectedSoftwareType, Mode=TwoWay}"/>
                    </Grid>
                </local:BlockWithQuestion.FieldContent>
            </local:BlockWithQuestion>
            <local:BlockWithQuestion HintText="{Binding HelpTextSelectSoftware, Mode=TwoWay}"
                                     Question="{Binding VisibleHelpTextSelectSoftware}"
                                     TitleText="{Binding TitleBlockPathSoftware}"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Height="100"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center"
                                     Width="250">
                <local:BlockWithQuestion.FieldContent>
                    <Grid>
                        <ContentControl Content="{Binding PathSoftware}"/>
                    </Grid>
                </local:BlockWithQuestion.FieldContent>
            </local:BlockWithQuestion>
            <local:BlockWithQuestion HintText="Данное поле отвечает за наименования приложения, то есть те названия, по которым бот будет понимать какую программу запускать"
                                     Question="Visible"
                                     TitleText="Наименования приложения"
                                     Grid.Row="3"
                                     Grid.RowSpan="2"
                                     VerticalAlignment="Stretch"
                                     HorizontalAlignment="Center"
                                     Width="280">
                <local:BlockWithQuestion.FieldContent>
                    <Grid>
                        <ScrollViewer Margin="0,0,10,0">
                            <ContentControl Margin="10" Content="{Binding ListNamesSoftware}">
                            </ContentControl>
                        </ScrollViewer>
                    </Grid>
                </local:BlockWithQuestion.FieldContent>
            </local:BlockWithQuestion>
            <local:BlockWithQuestion TitleText="Наименование приложения"
                                     Grid.Row="3"
                                     Grid.Column="1"
                                     Height="100"
                                     Grid.RowSpan="2"
                                     VerticalAlignment="Stretch"
                                     HorizontalAlignment="Center"
                                     Width="350">
                <local:BlockWithQuestion.FieldContent>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding AddSoftwareName}"/>
                        <Button Grid.Column="1"
                                Content="Добавить"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center" Click="AddNewNameSoftware"
                                />
                    </Grid>
                </local:BlockWithQuestion.FieldContent>
            </local:BlockWithQuestion>
            <Button Content="Сохранить"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Grid.Row="5"
                    Grid.ColumnSpan="2" Click="UpdateOrCreateSoftware"/>
        </Grid>
    </Border>

    <!-- Запуск анимации при загрузке -->
    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                   From="0" To="1"
                                   Duration="0:0:0.5"
                                   DecelerationRatio="0.9"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>
</Page>