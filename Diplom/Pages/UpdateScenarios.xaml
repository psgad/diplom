<Page x:Class="Diplom.UpdateScenarios"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom"
      mc:Ignorable="d" 
      Width="1200"
      Height="832"
      Title="UpdateScenarios">
    <Page.Resources>
        <DropShadowEffect x:Key="MaterialDesignShadow" 
                          ShadowDepth="2" 
                          Direction="270" 
                          Color="Black" 
                          Opacity="0.3" 
                          BlurRadius="5"/>
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                            From="0" To="1"
                            Duration="0:0:0.5"
                            DecelerationRatio="0.9"/>
        </Storyboard>
    </Page.Resources>

    <Border CornerRadius="15" Margin="10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2D2D2D" Offset="0"/>
                <GradientStop Color="#3C3C3C" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Настройка сценария"
                       Grid.Row="0"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       Margin="20,20,0,10"
                       HorizontalAlignment="Left"/>
            <Button VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Margin="100,10,10,10"
                    Content="Вернуться назад к сценариям" 
                    Grid.Column="1" 
                    Click="BackToApps"/>
            <Border Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="100"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Действия сценария"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Style="{DynamicResource subtitle}"/>
                    <Border Grid.Row="1" 
                            Margin="10"
                            CornerRadius="12"
                            BorderThickness="0.5"
                            BorderBrush="#fff">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      HorizontalAlignment="Center">
                            <WrapPanel x:Name="actions"
                                       Orientation="Horizontal"
                                       Margin="10"
                                       ItemWidth="920"
                                       AllowDrop="True"
                                       DragOver="WrapPanel_DragOver"
                                       Drop="WrapPanel_Drop">
                            </WrapPanel>
                        </ScrollViewer>
                    </Border>
                    <Button Grid.Row="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Margin="20,0,0,0"
                            Content="Добавить действие" 
                            Click="AddAction_Click"/>
                    <local:BlockWithQuestion Grid.Row="2"
                                             TitleText="Название сценария"
                                             Question="Visible"
                                             HintText="Данное поле отвечает за название, по которому будет производится поиск сценария (нельзя чтобы названия сценариев совпадали)"
                                             Margin="0,10,0,0"
                                             Width="250"
                                             VerticalAlignment="Top">
                        <local:BlockWithQuestion.FieldContent>
                            <TextBox Margin="10" Text="{Binding ScenariosName, UpdateSourceTrigger=PropertyChanged}"/>
                        </local:BlockWithQuestion.FieldContent>
                    </local:BlockWithQuestion>
                    <Button Grid.Row="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Margin="0,0,20,0"
                            Content="Сохранить"
                            Click="SaveScenario_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>

    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1"
                                     Duration="0:0:0.5"
                                     DecelerationRatio="0.9"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>
</Page>