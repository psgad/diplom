<Page x:Class="Diplom.BotAppsSettings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom"
      mc:Ignorable="d" Width="950"
      Title="DownloadBotPage" Height="832">

    <Border CornerRadius="15" Margin="10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2D2D2D" Offset="0"/>
                <GradientStop Color="#3C3C3C" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Список приложений"
                      Grid.Row="0"
                      FontSize="24"
                      FontWeight="Bold"
                      Foreground="#FFFFFF"
                      Margin="20,20,0,10"
                      HorizontalAlignment="Left"
                      />
            <Button VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Margin="10"
                    Cursor="Hand"
                    Content="Добавить приложение" Click="AddSoftware_Click"/>
            <ScrollViewer Grid.Row="1"
                          Margin="20"
                          HorizontalAlignment="Center"
                          VerticalScrollBarVisibility="Hidden">

                <WrapPanel Grid.Row="1"
                       Margin="20"
                       Orientation="Vertical"
                       x:Name="appsWrapPanel"
                       HorizontalAlignment="Center">
                </WrapPanel>
            </ScrollViewer>
        </Grid>
    </Border>

    <!-- Запуск анимации при загрузке -->
    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                   From="0" To="1"
                                   Duration="0:0:0.5"
                                   DecelerationRatio="0.9"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>
</Page>