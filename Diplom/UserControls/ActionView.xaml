<UserControl x:Class="Diplom.ActionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Diplom"
             mc:Ignorable="d" 
             Width="900"
             Margin="10"
             Height="150"
             AllowDrop="True"
             Drop="ActionView_Drop">
    <Border BorderThickness="0.25"
            BorderBrush="#fff"
            CornerRadius="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <local:BlockWithQuestion TitleText="Тип действия"
                                     Question="Visible"
                                     HintText="{Binding HintTextType}">
                <local:BlockWithQuestion.FieldContent>
                    <ComboBox ItemsSource="{Binding ActionTypes}" 
                              SelectedItem="{Binding SelectedType}" 
                              SelectionChanged="action_type_SelectionChanged"/>
                </local:BlockWithQuestion.FieldContent>
            </local:BlockWithQuestion>
            <local:BlockWithQuestion Grid.Column="1"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     x:Name="updatedBlock"/>
            <local:BlockWithQuestion TitleText="Время задержки (сек.)"
                                     Question="Visible"
                                     HintText="Данное поле отвечает за задержку после выполненного действия в секундах
                                     значение не должно быть больше 30 и меньше 0"
                                     Grid.Column="2">
                <local:BlockWithQuestion.FieldContent>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button Content="-" 
                                Width="40"
                                Height="40"
                                Click="Decrement_Click"/>
                        <TextBox Text="{Binding CounterText}" 
                                 Width="50" 
                                 TextAlignment="Center" 
                                 FontSize="16" Margin="10,0"/>
                        <Button Content="+" 
                                Width="40" 
                                Height="40"
                                Click="Increment_Click"/>
                    </StackPanel>
                </local:BlockWithQuestion.FieldContent>
            </local:BlockWithQuestion>
            <!-- Drag Handle Button -->
            <Button x:Name="DragHandle"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Grid.Column="2"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                    ToolTip="Перетащите для перемещения блока"
                    Style="{x:Null}"
                    Height="10"
                    Margin="0,5,10,0">
                <Path Data="M4,6 H20 V8 H4 V6 Z M4,10 H20 V12 H4 V10"
                      Fill="#FFFFFF"
                      Stretch="Uniform"
                      VerticalAlignment="Top"
                      HorizontalAlignment="Center"
                      Width="12"
                      Height="5"/>
            </Button>
            <Button Content="🗑️"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="Red"
                    Foreground="#fff"
                    BorderThickness="0"
                    x:Name="deleteAction"/>
        </Grid>
    </Border>
</UserControl>