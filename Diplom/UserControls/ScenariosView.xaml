<UserControl x:Class="Diplom.ScenariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Diplom"
             mc:Ignorable="d" 
             Height="150" 
             Width="800"
             Margin="10">
    <Border CornerRadius="22"
            BorderThickness="0.5"
            BorderBrush="#fff">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="3*"/>
            </Grid.RowDefinitions>
            <TextBlock Style="{DynamicResource title}"
                       Text="Название"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <TextBlock Style="{DynamicResource title}"
                       Grid.Column="1"
                       Text="Действий"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <TextBlock Style="{DynamicResource title}"
                       Text="Список действий"
                       Grid.Column="2"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="title_scenarios"
                       Style="{DynamicResource subtitle}"
                       d:Text="Презентация"
                       Grid.Row="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="count_actions"
                       d:Text="6 шт."
                       Style="{DynamicResource subtitle}"
                       Grid.Column="1"
                       Grid.Row="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"/>
            <TextBlock Text="Действия со сценарием"
                       Grid.Column="3"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Grid.ColumnSpan="2"
                       Style="{DynamicResource title}"/>
            <Border Grid.Column="2" 
                     Grid.Row="1" 
                    BorderThickness="0.25"
                    BorderBrush="Gray"
                    CornerRadius="12"
                     Margin="5">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalAlignment="Center">
                    <WrapPanel x:Name="actions_list"
                               
                               Orientation="Vertical"/>
                </ScrollViewer>
            </Border>
            <Button Content="✏️"
                    Grid.Column="3"
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="Green" Click="Button_Click"
                    />
            <Button Content="🗑️"
                    Grid.Row="1"
                    Grid.Column="4"
                    x:Name="deleteButton"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="Red"/>
        </Grid>
    </Border>
</UserControl>
