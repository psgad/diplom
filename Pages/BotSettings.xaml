<Page x:Class="Diplom.BotSettings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom"
      mc:Ignorable="d" Width="950"
      Title="DownloadBotPage" Height="632">
    <Page.Resources>
        <!-- Стиль для кнопки -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFA26048"/>
            <!-- Яркий оранжевый -->
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="25,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border 
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF8F00"/>
                    <!-- Чуть светлее при наведении -->
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFA26048"/>
                    <!-- Темнее при нажатии -->
                </Trigger>
            </Style.Triggers>
        </Style>


        <!-- Тень для эффекта Material Design -->
        <DropShadowEffect x:Key="MaterialDesignShadow" 
                          ShadowDepth="2" 
                          Direction="270" 
                          Color="Black" 
                          Opacity="0.3" 
                          BlurRadius="5"/>

        <!-- Анимация появления -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                            From="0" To="1"
                            Duration="0:0:0.5"
                            DecelerationRatio="0.9"/>
        </Storyboard>

    </Page.Resources>

    <!-- Основной контейнер -->
    <Border CornerRadius="15" Margin="10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2D2D2D" Offset="0"/>
                <GradientStop Color="#3C3C3C" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="110"/>
                <RowDefinition Height="110"/>
                <RowDefinition Height="110"/>
                <RowDefinition Height="110"/>
                <RowDefinition Height="110"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Настройки бота"
                      Grid.Row="0"
                      FontSize="24"
                      FontWeight="Bold"
                      Foreground="#FFFFFF"
                      Margin="20,20,0,10"
                      HorizontalAlignment="Left"/>
            <local:BlockWithQuestion Grid.Row="1"
                                     Width="500"
                                     Height="90"
                                     TitleText="Автозагрузка приложения"
                                     HintText="Данное поле дает разрешение боту автоматически производить запуск при включении компьютера"
                                     Question="Visible">
                <local:BlockWithQuestion.FieldContent>
                    <Border CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="#fff">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Добавление приложения бота в автозагрузки"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontSize="16"
                                   />
                            <CheckBox Grid.Column="1" IsChecked="{Binding AutoStartBot}"/>
                        </Grid>
                    </Border>
                </local:BlockWithQuestion.FieldContent>
            </local:BlockWithQuestion>
            <local:BlockWithQuestion Grid.Row="2"
                                     Width="500"
                                     Height="90"
                                     TitleText="Ярлык рабочего стола"
                                     HintText="Данное поле позволяет создать ярлык бота на рабочем столе для удобства запуска"
                                     Question="Visible">
                <local:BlockWithQuestion.FieldContent>
                    <Border CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="#fff">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Добавление ярлыка на рабочий стол"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontSize="16"
                                   />
                            <CheckBox Grid.Column="1" IsChecked="{Binding CreateLinkBot}"/>
                        </Grid>
                    </Border>
                </local:BlockWithQuestion.FieldContent>
            </local:BlockWithQuestion>
            <StackPanel Orientation="Horizontal"
                        Grid.Row="5"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center">


                <Button x:Name="DeleteBot"
                    Content="Удалить бота"
                    Grid.Row="5"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Margin="20"
                    Padding="15"
                    Background="Red" Click="DeleteBot_Click"/>
                <Button x:Name="SaveSettingsBot"
                    Content="Сохранить изменения"
                    Grid.Row="5"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="20"
                    Padding="15" Click="SaveSettingsBot_Click"/>

                <Button x:Name="StartBot"
                    Content="Запустить бота"
                    Grid.Row="5"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Margin="20"
                    Padding="15"
                    Background="Green" Click="StartBot_Click"/>
            </StackPanel>
        </Grid>
    </Border>

    <!-- Запуск анимации при загрузке -->
    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                   From="0" To="1"
                                   Duration="0:0:0.5"
                                   DecelerationRatio="0.9"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>
</Page>