<Page x:Class="Diplom.DownloadBotPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom"
      mc:Ignorable="d" Width="950"
      Title="DownloadBotPage" Height="632">
    <Page.Resources>
        <!-- Стиль для кнопки -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFA26048"/>
            <!-- Яркий оранжевый -->
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="25,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border 
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF8F00"/>
                    <!-- Чуть светлее при наведении -->
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFA26048"/>
                    <!-- Темнее при нажатии -->
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="Gray"/>
                    <Setter Property="Foreground" Value="DarkGray"/>
                </Trigger>
            </Style.Triggers>
        </Style>


        <!-- Тень для эффекта Material Design -->
        <DropShadowEffect x:Key="MaterialDesignShadow" 
                          ShadowDepth="2" 
                          Direction="270" 
                          Color="Black" 
                          Opacity="0.3" 
                          BlurRadius="5"/>

        <!-- Анимация появления -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                            From="0" To="1"
                            Duration="0:0:0.5"
                            DecelerationRatio="0.9"/>
        </Storyboard>
    </Page.Resources>

    <!-- Основной контейнер -->
    <Border CornerRadius="15" Margin="10" x:Name="mainBorder">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2D2D2D" Offset="0"/>
                <!-- Темно-серый -->
                <GradientStop Color="#3C3C3C" Offset="1"/>
                <!-- Чуть светлее -->
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Заголовок -->
                <RowDefinition Height="350"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="89"/>
                <RowDefinition Height="53"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Установка бота"
                      Grid.Row="0"
                      FontSize="24"
                      FontWeight="Bold"
                      Foreground="#FFFFFF"
                      Margin="20,20,0,10"
                      HorizontalAlignment="Left"/>

            <local:BlockWithQuestion HintText="Поле, подтверждающее что вы соглашаетессь с лицензионным соглашением"
                                     Grid.Row="2"
                                     Width="400"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     Question="Visible">
                <local:BlockWithQuestion.FieldContent>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Принять лицензионное соглашение"
                                   VerticalAlignment="Center"
                                   />
                        <CheckBox Grid.Column="1"
                                  VerticalAlignment="Top"
                                  IsChecked="{Binding AcceptLicence, Mode=TwoWay}"/>

                    </Grid>
                </local:BlockWithQuestion.FieldContent>
            </local:BlockWithQuestion>

            <!-- Основное содержимое -->
            <Border Grid.Row="3"
                    Background="#404040"
                    CornerRadius="10"
                    Effect="{StaticResource MaterialDesignShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ProgressBar x:Name="InstallProgress"
                                Grid.Row="1"
                                Height="20"
                                Margin="20,20,20,10"
                                Minimum="0"
                                Maximum="100"
                                Value="{Binding ProgressDownload, Mode=TwoWay}"
                                Foreground="#FF2F9035"
                                Background="#666666"
                                BorderThickness="0">
                        <ProgressBar.Effect>
                            <DropShadowEffect ShadowDepth="1" Color="Black" Opacity="0.3" BlurRadius="3"/>
                        </ProgressBar.Effect>
                    </ProgressBar>

                    <Button x:Name="InstallButton"
                            Grid.Row="2"
                            Content="Установить"
                            HorizontalAlignment="Center"
                            Click="DonwloadApp"
                            Padding="10,5"
                            IsEnabled="{Binding Install}"/>
                </Grid>
            </Border>

            <!-- Статус -->
            <local:BlockWithQuestion Question="Visible" 
                                     HintText="{Binding HintTextInstallHelper, Mode=TwoWay}"
                                     Grid.Row="4"
                                     HorizontalAlignment="Left">
                <local:BlockWithQuestion.FieldContent>

                    <TextBlock Grid.Row="4"
                               FontSize="14"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Margin="10, 10,10, 0"
                               >
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#BBBBBB"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsValid, Mode=TwoWay}" Value="False">
                                        <Setter Property="Foreground" Value="Red"/>
                                        <Setter Property="Opacity" Value="1"/>
                                        <Setter Property="Text" Value="Нет разрешения на установку"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <ColorAnimation
                                    Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                    From="Red" To="Transparent" Duration="0:0:0.5"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsValid, Mode=TwoWay}" Value="True">
                                        <Setter Property="Foreground" Value="Green"/>
                                        <Setter Property="Opacity" Value="1"/>
                                        <Setter Property="Text" Value="Бот готов к установке"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </local:BlockWithQuestion.FieldContent>
            </local:BlockWithQuestion>

            <Grid Grid.Row="1" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="85"/>
                    <RowDefinition Height="71"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <local:BlockWithQuestion TitleText="Путь до папки установки"
                    HintText="В данном поле указывается путь до папки, куда будет установлен бот"               
                                         Question="Visible"
                                         Grid.ColumnSpan="2"
                                         Margin="5"
                                         IsEnabled="{Binding Install, Mode=TwoWay}"
                                         >
                    <local:BlockWithQuestion.FieldContent>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding PathInstall, Mode=TwoWay}"/>
                            <Button Grid.Column="1"
                                    Margin="4, 1"
                                    Content="Выбрать папку"
                                    Click="FolderChanged"/>
                            <Button Grid.Column="2"
                                    Margin="4, 1"
                                    Content="На рабочий стол"
                                    Click="ChangeDesktopFolder"/>
                        </Grid>
                    </local:BlockWithQuestion.FieldContent>
                </local:BlockWithQuestion>
                <local:BlockWithQuestion HintText="Данное поле определяет будет ли создан ярлык бота на рабочем столе"
                                         Grid.Row="1"
                                         Margin="10"
                                         Width="350"
                                         VerticalAlignment="Top"
                                         Question="Visible"
                                         >
                    <local:BlockWithQuestion.FieldContent>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Создать ярлык на рабочем столе" 
                                       VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1"
                                      Grid.ColumnSpan="2"
                                      IsChecked="{Binding CreateLinkInDesktopFolder, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"/>
                        </Grid>
                    </local:BlockWithQuestion.FieldContent>
                </local:BlockWithQuestion>
                <local:BlockWithQuestion HintText="Данное поле определяет будет ли добавлен исполняемый файл в автозагрузки компьютера"
                                         Width="350"
                                         Grid.Row="1"
                                         Margin="10"
                                         Grid.Column="1"
                                         VerticalAlignment="Top"
                                         Question="Visible"
                                         >
                    <local:BlockWithQuestion.FieldContent>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Добавить в автозагрузки" 
                                       VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding AppendInAutoDownloads, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"/>
                        </Grid>
                    </local:BlockWithQuestion.FieldContent>
                </local:BlockWithQuestion>
                <local:BlockWithQuestion Grid.Row="3"
                                         Margin="15,0,15,0"
                                         TitleText="Лицензионное соглашение"
                                         Grid.ColumnSpan="2"
                                         VerticalAlignment="Top"
                                         Height="200"
                                         >
                    <local:BlockWithQuestion.FieldContent>
                        <TextBox IsReadOnly="True"
                                     BorderThickness="1"
                                     Style="{x:Null}"
                                     Background="Transparent"
                                     Foreground="#fff"
                                     Text="{Binding LicenceText, Mode=TwoWay}"
                                     FontSize="16"
                                     MaxWidth="850"
                                     TextWrapping="Wrap"
                                     Height="80"
                                     VerticalAlignment="Top"
                                     AcceptsReturn="True"
                                     Cursor="Arrow"/>
                    </local:BlockWithQuestion.FieldContent>
                </local:BlockWithQuestion>
            </Grid>

        </Grid>
    </Border>

    <!-- Запуск анимации при загрузке -->
    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                   From="0" To="1"
                                   Duration="0:0:0.5"
                                   DecelerationRatio="0.9"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>
</Page>