<Page x:Class="Diplom.Guide"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Guide" Width="1000"
      Background="#2D2D2D">

    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#fff"/>
            <Setter Property="BorderBrush" Value="#000"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15"
                                Padding="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#f5f5f5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <StackPanel Height="40" VerticalAlignment="Top" HorizontalAlignment="Left">
            <Button Content="1. Ознакомление"/>
        </StackPanel>

        <Border Background="#3C3C3C" CornerRadius="10" Padding="20" Margin="0,40,0,0">
            <RichTextBox IsReadOnly="True" BorderThickness="0" Background="#3C3C3C" Foreground="White" FontSize="14" FontFamily="Segoe UI">
                <FlowDocument>
                    <Paragraph FontSize="24" FontWeight="Bold" Foreground="White">Руководство пользователя голосового ассистента "Джарвис"</Paragraph>

                    <Paragraph>
                        Добро пожаловать в помощника "Джарвис". Этот ассистент позволяет управлять вашим компьютером голосом.
                        В этом руководстве описаны все доступные команды, примеры использования, а также информация по настройке.
                    </Paragraph>

                    <Section>
                        <Paragraph FontSize="18" FontWeight="Bold">🛠 Настройка ассистента</Paragraph>
                        <Paragraph>
                            Вы можете настроить список доступных программ, которые можно открывать, закрывать, добавлять в автозагрузку.
                            Это делается через конфигурационный файл или интерфейс администратора.
                        </Paragraph>
                        <Paragraph FontStyle="Italic">Не забудьте сохранить изменения после редактирования конфигурации!</Paragraph>
                    </Section>

                    <Section>
                        <Paragraph FontSize="18" FontWeight="Bold">📂 Команды управления программами</Paragraph>
                        <List MarkerStyle="Disc">
                            <ListItem>
                                <Paragraph>Открой [название] — запуск программы</Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph>Закрой [название] — закрытие программы</Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph>Удали [название] — удаление программы</Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph>Добавь в автозагрузку [название] — автозапуск при старте системы</Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph>Удали из автозагрузки [название]</Paragraph>
                            </ListItem>
                        </List>
                    </Section>

                    <Section>
                        <Paragraph FontSize="18" FontWeight="Bold">🔊 Управление системой</Paragraph>
                        <List MarkerStyle="Disc">
                            <ListItem>
                                <Paragraph>Выключи — завершение работы</Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph>Перезагрузи — перезапуск ПК</Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph>Спящий — переход в спящий режим</Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph>Заблокируй — блокировка экрана</Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph>Громкость вверх/вниз</Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph>Громкость на [число от 0 до 100]</Paragraph>
                            </ListItem>
                        </List>
                    </Section>

                    <Section>
                        <Paragraph FontSize="18" FontWeight="Bold">💡 Примеры</Paragraph>
                        <Paragraph>
                            Ниже приведены примеры команд:
                        </Paragraph>
                        <List>
                            <ListItem>
                                <Paragraph>"Джарвис, открой телегу"</Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph>"Джарвис, добавь телегу в автозагрузку"</Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph>"Джарвис, громкость на 50"</Paragraph>
                            </ListItem>
                        </List>
                    </Section>

                    <Section>
                        <Paragraph FontSize="18" FontWeight="Bold">🌐 Поиск в интернете</Paragraph>
                        <Paragraph>
                            Для поиска используйте команду:
                            <Bold>Найди в браузере [запрос]</Bold>
                        </Paragraph>
                        <Paragraph FontStyle="Italic">
                            Пример: "Джарвис, найди в браузере как сварить борщ"
                        </Paragraph>
                    </Section>

                    <Section>
                        <Paragraph FontSize="18" FontWeight="Bold">🎨 Темы оформления</Paragraph>
                        <Paragraph>
                            Для смены темы: "Джарвис, смени тему на тёмную" или "на светлую"
                        </Paragraph>
                    </Section>

                    <Section>
                        <Paragraph FontSize="18" FontWeight="Bold">🧠 Переключение между окнами</Paragraph>
                        <Paragraph>
                            Вы можете переключаться между окнами по номеру или по порядку:
                        </Paragraph>
                        <List>
                            <ListItem>
                                <Paragraph>"Джарвис, переключи на 2"</Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph>"Джарвис, переключи на следующее окно"</Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph>"Джарвис, переключи на прошлое окно"</Paragraph>
                            </ListItem>
                        </List>
                    </Section>

                    <Section>
                        <Paragraph FontSize="18" FontWeight="Bold">⌨️ Нажатие клавиш</Paragraph>
                        <Paragraph>
                            Вы можете голосом нажимать заранее настроенные клавиши:
                        </Paragraph>
                        <List>
                            <ListItem>
                                <Paragraph>"Джарвис, нажми пробел"</Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph>"Джарвис, нажми запуск"</Paragraph>
                            </ListItem>
                        </List>
                    </Section>

                    <!-- Добавляем таблицу -->
                    <Section>
                        <Paragraph FontSize="18" FontWeight="Bold">📊 Таблица доступных команд</Paragraph>
                        <Table>
                            <TableRowGroup>
                                <TableRow>
                                    <TableCell>
                                        <Paragraph>
                                            <Bold>Команда</Bold>
                                        </Paragraph>
                                    </TableCell>
                                    <TableCell>
                                        <Paragraph>
                                            <Bold>Описание</Bold>
                                        </Paragraph>
                                    </TableCell>
                                </TableRow>
                                <TableRow>
                                    <TableCell>
                                        <Paragraph>Открой [название]</Paragraph>
                                    </TableCell>
                                    <TableCell>
                                        <Paragraph>Запуск программы</Paragraph>
                                    </TableCell>
                                </TableRow>
                                <TableRow>
                                    <TableCell>
                                        <Paragraph>Закрой [название]</Paragraph>
                                    </TableCell>
                                    <TableCell>
                                        <Paragraph>Закрытие программы</Paragraph>
                                    </TableCell>
                                </TableRow>
                                <TableRow>
                                    <TableCell>
                                        <Paragraph>Громкость на [число]</Paragraph>
                                    </TableCell>
                                    <TableCell>
                                        <Paragraph>Установка уровня громкости</Paragraph>
                                    </TableCell>
                                </TableRow>
                            </TableRowGroup>
                        </Table>
                    </Section>

                    <!-- Пример добавления изображения -->
                    <Section>
                        <Paragraph FontSize="18" FontWeight="Bold">🖼 Пример интерфейса</Paragraph>
                        <Paragraph>
                            Вот как будет выглядеть интерфейс в тёмной теме:
                        </Paragraph>
                    </Section>

                </FlowDocument>
            </RichTextBox>
        </Border>
    </Grid>
</Page>
