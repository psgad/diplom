; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

[Setup]
AppName=VoiceAssistant
AppVerName=1.0
AppPublisher=psgad
AppPublisherURL=https://psgad.stariybog.ru
AppSupportURL=https://psgad.stariybog.ru
AppUpdatesURL=https://psgad.stariybog.ru
DefaultDirName={pf}\VoiceAssistant
DefaultGroupName=VoiceAssistant

[Tasks]
Name: "desktopicon"; Description: "Create a &desktop icon"; GroupDescription: "Additional icons:"

[Files]
Source: "C:\Users\Juras\source\repos\Diplom\Diplom\bin\Debug\Diplom.exe"; DestDir: "{app}"; Flags: ignoreversion
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{group}\VoiceAssistant"; Filename: "{app}\Diplom.exe"
Name: "{userdesktop}\VoiceAssistant"; Filename: "{app}\Diplom.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\Diplom.exe"; Description: "Launch VoiceAssistant"; Flags: nowait postinstall skipifsilent

